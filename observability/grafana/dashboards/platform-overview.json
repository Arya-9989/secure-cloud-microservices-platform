    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors by service",
      "description": "Client (4xx, solid) and server (5xx, dashed) error responses per service. 401 and 403 spikes usually mean expired or under-scoped tokens; 5xx means a bug or a failing dependency.",
