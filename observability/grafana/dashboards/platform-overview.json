        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (label_replace(label_replace(rate(traefik_service_requests_total[$__rate_interval]), \"class\", \"${1}xx\", \"code\", \"([0-9])..\"), \"class\", \"429\", \"code\", \"429\"))",
          "legendFormat": "{{class}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e93"
          },
          "custom": {
