          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_requests_seconds_bucket{uri!~\"/healthz|/readyz|/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p99",
          "refId": "B",
          "range": true
