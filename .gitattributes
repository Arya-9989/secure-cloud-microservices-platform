# Normalise line endings: everything is LF in the repo and in working copies,
# so shell scripts and configs mounted into Linux containers keep working on
# Windows checkouts. Windows-only scripts keep CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.webp binary
*.woff2 binary
*.jar binary
