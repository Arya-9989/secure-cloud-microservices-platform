# Local configuration for docker compose.
#
#   python scripts/init_env.py      # writes .env, replacing every <generate> with a random secret
#
# .env is git-ignored. Never reuse these values outside your machine.

COMPOSE_PROJECT_NAME=secure-platform

# Host ports (bound to 127.0.0.1 except the gateway)
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# Distributed tracing (OpenTelemetry -> Jaeger). Switch both on together:
#   COMPOSE_PROFILES=tracing
#   TRACING_ENABLED=true
COMPOSE_PROFILES=
TRACING_ENABLED=false

# PostgreSQL: superuser plus one least-privilege role per service database
POSTGRES_PASSWORD=<generate>
AUTH_DB_PASSWORD=<generate>
ORDERS_DB_PASSWORD=<generate>

# Auth service
DJANGO_SECRET_KEY=<generate>
JWT_ISSUER=urn:secure-platform:auth-service
JWT_AUDIENCE=secure-platform-api
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=<generate>

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate>
